# Salin menjadi .env lalu isi yang Anda punya. Semua opsional.

# Garam untuk pseudonim penulis (ADR-CRW-0002). Jika kosong, crawler membuatnya sendiri di .env saat pertama jalan.
# JANGAN diganti setelah ada data: penulis yang sama akan mendapat pseudonim berbeda.
CRAWLER_GARAM=

# Identitas sopan di setiap permintaan HTTP.
CRAWLER_USER_AGENT=ecosystem-crawler/0.1 (riset pribadi)

# Email kontak opsional untuk "polite pool" OpenAlex (permintaan sedikit diprioritaskan). Kosong = tetap jalan.
CRAWLER_MAILTO=

# Proxy opsional untuk semua permintaan HTTP (requests + curl_cffi). Kosong = pakai IP langsung (koneksi rumah).
# Contoh: http://user:sandi@host:port  atau  socks5://host:port  (SOCKS perlu: pip install "requests[socks]")
# Berguna bila sebuah situs memblokir IP Anda. Untuk pemakaian kecil biasanya belum perlu.
CRAWLER_PROXY=

# Sakelar Owner (ADR-CRW-0010). Default: robots.txt tidak dipatuhi, tingkat stealth menyala.
# CRAWLER_PATUHI_ROBOTS=0
# CRAWLER_STEALTH=1

# Reddit API resmi via PRAW (gratis, perlu persetujuan). Jika kosong, sumber reddit tidak aktif; pakai arctic_shift.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# YouTube Data API v3 (gratis, kuota 10.000 unit/hari). Jika kosong, sumber youtube tidak aktif. Cara membuat: README.
YOUTUBE_API_KEY=
