# Salin jadi `.env`, lalu isi. `.env` di-gitignore dan TIDAK boleh ikut ter-commit.
#
# Ditambahkan 2026-10-08 (M8): sebelum ini nama kedua variabel di bawah tidak tercatat di mana pun
# dalam version control — `src/lib/supabase.js` memanggilnya, tetapi orang yang baru meng-clone repo
# tidak punya cara tahu apa yang harus diisi selain membaca kodenya.
#
# Keduanya ber-awalan VITE_, jadi DISISIPKAN KE DALAM BUNDEL saat build dan terlihat siapa pun yang
# membuka aplikasinya. Itu benar untuk kunci anon — perlindungannya ada di RLS, bukan di kerahasiaan
# kunci. Jangan pernah menaruh service-role key di sini.

VITE_SUPABASE_URL=https://contoh-proyek.supabase.co
VITE_SUPABASE_ANON_KEY=ganti-dengan-kunci-anon-proyek-anda

# Kunci OpenRouter TIDAK ada di sini. Tiap pengguna memasangnya sendiri lewat ikon gerigi di
# aplikasi, dan ia disimpan di localStorage perangkatnya (BYOK).
